#!/bin/bash
# waves-validate — kernel rail: artifact schema validation (w6 Phase 13).
#
# Gives a single CLI home to the validation the commands run inline today
# (python3 -m jsonschema with plugin schema paths). Consumers: the pre-commit
# backstop (phase 13 primary 3), commands, and any product bundling the kernel.
#
# Self-contained: artifact and schema are explicit arguments. No schema-by-type
# resolution here — the CALLER knows which schema governs the artifact (the
# plugin resolves from its skills/references; the PCC from its own copy).
#
# Usage:
#   waves-validate <artifact.json> --schema <schema.json>
#
# Exit codes: 0 = valid, 2 = invalid (errors on stderr), 1 = usage/internal error.
#
# Degradation: when python3 (or its jsonschema module) is unavailable, degrades
# to a JSON well-formedness check via jq, with an explicit warning on stderr —
# visible degradation, never a silent pass-as-validated.

set -euo pipefail

ARTIFACT="" SCHEMA=""
while [ $# -gt 0 ]; do
  case "$1" in
    --schema) SCHEMA="${2:-}"; shift 2 ;;
    --help)
      grep '^# ' "$0" | head -18 | sed 's/^# \{0,1\}//'
      exit 0 ;;
    -*) echo "waves-validate: unknown argument $1" >&2; exit 1 ;;
    *) ARTIFACT="$1"; shift ;;
  esac
done

[ -n "$ARTIFACT" ] || { echo "waves-validate: artifact path required (see --help)" >&2; exit 1; }
[ -f "$ARTIFACT" ] || { echo "waves-validate: artifact not found: $ARTIFACT" >&2; exit 1; }
[ -n "$SCHEMA" ] || { echo "waves-validate: --schema is required" >&2; exit 1; }
[ -f "$SCHEMA" ] || { echo "waves-validate: schema not found: $SCHEMA" >&2; exit 1; }

# Well-formedness first (cheap, jq is the kernel's only hard dependency)
if command -v jq &>/dev/null; then
  if ! jq -e . "$ARTIFACT" >/dev/null 2>&1; then
    echo "waves-validate: $ARTIFACT is not valid JSON" >&2
    exit 2
  fi
fi

# Schema validation via python jsonschema (same mechanism the commands use).
# Probe several interpreters: the module may live in one version's user-site
# only (e.g. python3.11 has it while the bare python3 does not).
PYBIN=""
for py in python3 python3.13 python3.12 python3.11 python3.10 python; do
  if command -v "$py" &>/dev/null && "$py" -c 'import jsonschema' 2>/dev/null; then
    PYBIN="$py"
    break
  fi
done
if [ -n "$PYBIN" ]; then
  ERRORS=$("$PYBIN" - "$ARTIFACT" "$SCHEMA" <<'PYEOF' 2>&1
import json, sys
import jsonschema
artifact = json.load(open(sys.argv[1]))
schema = json.load(open(sys.argv[2]))
validator = jsonschema.Draft7Validator(schema)
errs = sorted(validator.iter_errors(artifact), key=lambda e: list(e.path))
for e in errs:
    path = "/".join(str(p) for p in e.path) or "(root)"
    print(f"{path}: {e.message[:200]}")
sys.exit(2 if errs else 0)
PYEOF
  ) && RC=0 || RC=$?
  if [ "$RC" -ne 0 ]; then
    printf '%s\n' "$ERRORS" >&2
    exit 2
  fi
  exit 0
fi

echo "waves-validate: WARNING — no python interpreter with jsonschema found; only JSON well-formedness was checked for $ARTIFACT" >&2
exit 0
